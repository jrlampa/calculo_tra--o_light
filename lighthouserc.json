{
  "ci": {
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:pwa": [
          "warn",
          {
            "minScore": 0.8,
            "aggregationMethod": "median"
          }
        ],
        "metrics:first-contentful-paint": [
          "error",
          {
            "maxNumericValue": 3000,
            "aggregationMethod": "median"
          }
        ],
        "metrics:largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 4000,
            "aggregationMethod": "median"
          }
        ],
        "metrics:cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "collect": {
      "url": [
        "http://localhost:5173/",
        "http://localhost:5173/app",
        "http://localhost:5173/app/novo-projeto"
      ],
      "numberOfRuns": 3,
      "staticDistDir": "./dist",
      "chromePath": "/usr/bin/google-chrome-stable",
      "settings": {
        "chromeFlags": "--no-sandbox --headless --disable-dev-shm-usage"
      }
    },
    "upload": {
      "target": "temporary-public-storage",
      "baseBranch": "dev",
      "ignoreBranches": []
    },
    "server": {
      "lighthouseVersion": "latest"
    },
    "storage": {
      "storageMethod": "github",
      "githubToken": "${{ secrets.LHCI_GITHUB_APP_TOKEN }}"
    }
  }
}
