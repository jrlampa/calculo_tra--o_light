# Supabase PostgreSQL Connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# Optional: For API-based access (REST calls)
SUPABASE_URL=https://[PROJECT-ID].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Database mode: 'supabase' or 'local'
DB_MODE=supabase

# ── Authentication (python/api/auth.py) ──────────────────────────────────────
# REQUIRED in production (APP_ENV=production). Startup raises RuntimeError if unset.
AUTH_SESSION_SECRET=your-strong-random-secret-here

# REQUIRED in production to enable JWT verification.
# Use: openssl rand -hex 32    (or copy from Supabase → Settings → API → JWT secret)
AUTH_JWT_SECRET=your-supabase-jwt-secret-or-own-hs256-secret

# Optional: enable/disable JWT requirement for write operations.
# Default: TRUE (always required). Set to false only for local dev.
# AUTH_REQUIRE_JWT_FOR_MUTATIONS=false

# Optional: static admin bearer token for X-Admin-Token header.
# If unset, only JWT with role=admin grants admin access.
# AUTH_ADMIN_TOKEN=your-strong-admin-token

# Optional: environment flag — triggers production-safe guards when set to production.
# APP_ENV=production
